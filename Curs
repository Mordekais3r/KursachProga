            for (auto& [nbr, w] : adj[cur]) {
                if (!visited[nbr]) {
                    visited[nbr] = true;
                    q.push(nbr);
                }
            }
        }
        cout << endl;
    }

    void dfsUtil(int v, unordered_map<int,bool>& visited) {
        visited[v] = true;
        cout << v << " ";
        for (auto& [nbr, w] : adj[v]) {
